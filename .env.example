# Copy to .env (repo root or backend/) for local development.
OPENAI_API_KEY=            # leave empty to run in demo mode (rule-based agents)
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
JWT_SECRET=change-me-to-a-long-random-string
MAX_FOLLOWUPS=4
CLINIC_TIMEZONE=America/New_York
# DATABASE_URL=postgresql://user:pass@host:5432/db   # optional; defaults to SQLite in backend/data
SHOW_DEMO_ACCOUNTS=false
##